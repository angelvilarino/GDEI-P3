          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 4 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 13, "w": 14, "x": 0, "y": 5 },
      "id": 5,
      "options": {
        "colWidth": 0.9,
        "fillOpacity": 75,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "rowHeight": 0.85,
        "showValue": "auto",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "auravault-crate" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t AS time, ctr AS metric, CAST(SUM(cnt) AS INTEGER) AS value FROM (SELECT date_trunc('hour', time_index) AS t, split_part(split_part(entity_id, ':', 4), '-', 1) AS ctr, SUM(CASE WHEN co2 > 700 OR relativehumidity > 65 OR temperature > 26 THEN 1 ELSE 0 END) AS cnt FROM etindoorenvironmentobserved WHERE $__timeFilter(time_index) GROUP BY date_trunc('hour', time_index), split_part(split_part(entity_id, ':', 4), '-', 1) UNION ALL SELECT date_trunc('hour', time_index), split_part(split_part(entity_id, ':', 4), '-', 1), SUM(CASE WHEN laeq > 65 THEN 1 ELSE 0 END) FROM etnoiselevelobserved WHERE $__timeFilter(time_index) GROUP BY date_trunc('hour', time_index), split_part(split_part(entity_id, ':', 4), '-', 1)) sub GROUP BY t, ctr ORDER BY t",
          "refId": "A"
        }
      ],
      "title": "Mapa de Calor — Frecuencia de Alertas por Centro",
      "type": "status-history"
    },

    {
      "datasource": { "type": "postgres", "uid": "auravault-crate" },
      "description": "Distribucion de lecturas que superan umbrales de alerta, clasificadas por categoria y severidad",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
