    {
      "datasource": { "type": "postgres", "uid": "auravault-crate" },
      "description": "Frecuencia de alertas ambientales (CO2>700ppm, humedad>65%, temp>26°C, ruido>65dB) por centro y franja horaria",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
