      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "auravault-crate" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cat AS \"Categoria\", cnt AS \"Incidentes\" FROM (SELECT 'CO2 Critico (>1200ppm)' AS cat, CAST(COUNT(*) AS INTEGER) AS cnt FROM etindoorenvironmentobserved WHERE $__timeFilter(time_index) AND co2 > 1200 UNION ALL SELECT 'CO2 Alto (800-1200ppm)', CAST(COUNT(*) AS INTEGER) FROM etindoorenvironmentobserved WHERE $__timeFilter(time_index) AND co2 BETWEEN 800 AND 1200 UNION ALL SELECT 'CO2 Moderado (600-800ppm)', CAST(COUNT(*) AS INTEGER) FROM etindoorenvironmentobserved WHERE $__timeFilter(time_index) AND co2 BETWEEN 600 AND 800 UNION ALL SELECT 'Humedad Alta (>70%)', CAST(COUNT(*) AS INTEGER) FROM etindoorenvironmentobserved WHERE $__timeFilter(time_index) AND relativehumidity > 70 UNION ALL SELECT 'Ruido Critico (>75dB)', CAST(COUNT(*) AS INTEGER) FROM etnoiselevelobserved WHERE $__timeFilter(time_index) AND laeq > 75 UNION ALL SELECT 'Ruido Alto (65-75dB)', CAST(COUNT(*) AS INTEGER) FROM etnoiselevelobserved WHERE $__timeFilter(time_index) AND laeq BETWEEN 65 AND 75) t WHERE cnt > 0 ORDER BY cnt DESC",
          "refId": "A"
        }
      ],
      "title": "Distribucion de Incidentes por Categoria y Severidad",
      "type": "piechart"
    },

